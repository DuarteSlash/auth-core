<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>co.gentiac.authcore</groupId>
    <artifactId>auth-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>auth-core</name>
    <description>Componente reutilizable de ingreso seguro: autenticación, autorización RBAC y auditoría (arquitectura hexagonal)</description>

    <!--
      Dirección de dependencias (constitución, principio VII):
        auth-bootstrap → auth-infrastructure → auth-application → auth-domain
      auth-domain y auth-application NO dependen de Spring ni de ningún proveedor.
    -->
    <modules>
        <module>auth-domain</module>
        <module>auth-application</module>
        <module>auth-infrastructure</module>
        <module>auth-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.4.1</archunit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>co.gentiac.authcore</groupId>
                <artifactId>auth-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>co.gentiac.authcore</groupId>
                <artifactId>auth-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>co.gentiac.authcore</groupId>
                <artifactId>auth-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
